@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5">

    <h1 class="fw-bold">My Results</h1>

    <p class="text-muted mb-4">
        View your race history and achievements.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h4>No Results Available Yet</h4>

                <p class="text-muted">
                    Your race results will appear here once an organiser
                    has recorded and published them.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-dark">
                    Explore Events
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var result in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <span class="badge bg-success mb-2">
                                @result.ResultStatus
                            </span>

                            <h4 class="fw-bold">
                                @result.EventName
                            </h4>

                            <p>
                                <strong>Event Date:</strong>
                                @result.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @result.CategoryName
                            </p>

                            <p>
                                <strong>Finish Time:</strong>
                                @(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "Not recorded")
                            </p>

                            <p>
                                <strong>Finishing Position:</strong>

                                @if (result.Position.HasValue)
                                {
                                    @result.Position.Value

                                    if (result.TotalFinishers.HasValue)
                                    {
                                        <span>
                                            out of @result.TotalFinishers finishers
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>Not recorded</span>
                                }
                            </p>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>
