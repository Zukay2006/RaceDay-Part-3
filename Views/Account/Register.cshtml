@model RaceDay.MVC.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center fw-bold">Join RaceDay</h2>
                    <p class="text-center text-muted">Create your account today.</p>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">Phone Number</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Register As</label>
                            <select asp-for="Role" class="form-select">
                                <option value="">Select your role</option>
                                <option value="Organiser">Organiser</option>
                                <option value="Participant">Participant</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            Create Account
                        </button>

                    </form>

                    <p class="text-center mt-3">
                        Already registered?
                        <a asp-action="Login">Login here</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
