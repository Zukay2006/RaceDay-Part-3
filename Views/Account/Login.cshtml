@model RaceDay.MVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center fw-bold">RaceDay</h2>
                    <p class="text-center text-muted">Welcome back! Sign in to continue.</p>

                    <form asp-action="Login" method="post">

                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Login As</label>
                            <select asp-for="Role" class="form-select">
                                <option value="">Select your role</option>
                                <option value="Organiser">Organiser</option>
                                <option value="Participant">Participant</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">
                            Login
                        </button>

                    </form>

                    <p class="text-center mt-3">
                        Don't have an account?
                        <a asp-action="Register">Register here</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
