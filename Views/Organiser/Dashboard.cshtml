@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-2">Organiser Dashboard</h2>
    <p class="text-muted">Welcome to your RaceDay management area.</p>

    <div class="row g-4 mt-3">
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Events</h5>
                <p>Create and manage race events.</p>
                <a asp-controller="Organiser"
                   asp-action="Events"
                   class="btn btn-primary">
                    Manage Events
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Categories</h5>
                <p>Manage event race categories.</p>
                <a asp-controller="Organiser"
                   asp-action="Categories"
                   class="btn btn-primary">
                    Manage Categories
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>Results</h5>
                <p>View enrolments and manage race results.</p>
                <a asp-controller="Organiser"
                   asp-action="Results"
                   class="btn btn-primary">
                    Manage Results
                </a>
            </div>
        </div>
    </div>
</div>