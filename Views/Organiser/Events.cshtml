@model List<RaceDay.MVC.Models.OrganiserEventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Events</h2>
            <p class="text-muted">View and manage your race events.</p>
        </div>

        <a asp-action="CreateEvent" class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No events found yet. Create your first race event.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.EventName</h5>

                            <p class="text-muted mb-2">
                                @item.EventDate.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.DistanceKM km</p>
                            <p><strong>Type:</strong> @item.EventType</p>

                            <span class="badge bg-primary">
                                @item.Status
                            </span>

                            <div class="mt-3">
                                <a asp-action="EditEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <form asp-action="DeleteEvent"
                                      asp-route-id="@item.EventID"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>